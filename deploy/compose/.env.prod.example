# Production environment template for deploy/compose/docker-compose.prod.yml
# Copy to deploy/compose/.env and fill in every value.
# REQUIRED variables use the ${VAR:?message} syntax in the compose file -
# docker compose will refuse to start if any is missing.

# ─── Image pin ──────────────────────────────────────────────────────────────
# REQUIRED - no default. Set the exact Farna Control version you intend to run.
# Example: TAG=v0.4.0
TAG=

# ─── Generated secrets ──────────────────────────────────────────────────────
# Generate each once and store securely. Do not reuse across environments.

# SECRET_KEY: 32+ random bytes (44 base64 chars). Rotation invalidates all JWT sessions.
# Generate: openssl rand -base64 32
SECRET_KEY=

# FERNET_KEY: 44-char urlsafe base64 (32 bytes decoded). Must be a REAL Fernet key.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# FARNA_CONTROL_DB_PASSWORD: Database password for the modulo, farna_control_app, and farna_control_system roles.
# Generate: openssl rand -base64 16
FARNA_CONTROL_DB_PASSWORD=

# SAQ_AUTH_USERNAME: SAQ web dashboard username (fail-closed if missing).
SAQ_AUTH_USERNAME=admin

# SAQ_AUTH_PASSWORD: SAQ web dashboard password (fail-closed if missing).
# Generate: openssl rand -base64 16
SAQ_AUTH_PASSWORD=

# ─── Optional / deployment-specific ─────────────────────────────────────────
# FARNA_CONTROL_PUBLIC_URL: Browser-facing base URL (SSO redirects, absolute links).
# FARNA_CONTROL_PUBLIC_URL=https://farna-control.example.com

# REDIS_URL: External/managed Redis. Default = compose's internal redis service.
# REDIS_URL=redis://redis:6379/0

# FARNA_CONTROL_LOG_LEVEL: Log level (debug, info, warning, error).
# FARNA_CONTROL_LOG_LEVEL=info

# FARNA_CONTROL_LICENSE_KEY: License key for Team/Enterprise features.
# FARNA_CONTROL_LICENSE_KEY=

# Product analytics — OPT-IN, OFF by default. "No telemetry by default" holds
# while these are empty (the default): leaving any of the three blank disables
# delivery. Set all three to send daily aggregate counts (entity counts, run
# statistics, error-family counts, provider/connector inventory) to Farnalabs.
# The native installers ask this same question once during first-run setup,
# default OFF, and write the answer to the launcher's config.env (mode 600).
#   Generate the secret with: openssl rand -hex 32
# FARNA_CONTROL_PRODUCT_ANALYTICS_ENDPOINT_URL=
# FARNA_CONTROL_PRODUCT_ANALYTICS_INSTANCE_SECRET=
# FARNA_CONTROL_PRODUCT_ANALYTICS_ENABLED=

# SMTP for HITL alert email and watchdog.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# ALERT_EMAIL_TO=

# DB_CAPACITY_PATH: Mount point for the postgres_data volume (capacity monitor).
# DB_CAPACITY_PATH=/var/lib/farna/db-volume

# SAQ_WORKER_DB_POOL_SIZE: Per-worker DB pool size (default 20, sized for SAQ_WORKER_CONCURRENCY=5).
# SAQ_WORKER_DB_POOL_SIZE=20
