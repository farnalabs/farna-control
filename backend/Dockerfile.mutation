# check=skip=SecretsUsedInArgOrEnv
# One-shot mutation testing container for the backend
# Build from repo root: docker build -t modulo-mutmut -f backend/Dockerfile.mutation .
# Run: docker run --rm modulo-mutmut
# With custom paths: docker run --rm modulo-mutmut uv run mutmut run --paths-to-mutate "src/farna/auth/" "src/farna/db/rls.py"

FROM python:3.14-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Build deps for psycopg, bcrypt, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency manifests
COPY backend/pyproject.toml backend/uv.lock ./

# Install all dev dependencies.
# --no-build (docker:S8541): never execute sdist setup scripts. ibm-cos-sdk and
# pytest-bdd publish sdist-only, so those pinned distributions are re-allowed
# individually; every other dependency must come from a pre-built wheel. NOSONAR
# comments are not supported in Dockerfiles, hence the explicit flags.
RUN uv sync --dev --frozen --no-build \
    --no-binary-package ibm-cos-sdk \
    --no-binary-package ibm-cos-sdk-core \
    --no-binary-package ibm-cos-sdk-s3transfer \
    --no-binary-package pytest-bdd \
    --no-binary-package farna-control

# Copy source code and tests
COPY backend/src/ src/
COPY backend/tests/ tests/

# Required non-production test values (the database is never contacted).
ENV DATABASE_URL=postgresql+asyncpg://unused:unused@localhost/unused
ENV SECRET_KEY=docker-mutation-secret-key-not-for-production
ENV FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Default runs all configured paths
RUN useradd --create-home --uid 10001 appuser && \
    chown -R appuser:appuser /app
USER appuser
# Run the pre-built mutmut binary directly (no `uv run`, which would re-sync
# and execute package build/setup scripts) to keep the image SonarCloud-clean.
CMD ["/app/.venv/bin/mutmut", "run"]
